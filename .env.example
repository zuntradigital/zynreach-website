# ---------------------------------------------------------------------------
# Environment configuration (SRS Section 30.5: Secrets Management)
#
# Copy this file to .env.local for local development. Never commit real
# values — .env* is already gitignored.
#
# Every credential-gated integration in this codebase (see the "BLOCKER"
# comments in src/lib/services/*.ts and src/lib/monitoring.ts) is written
# against a real, working default behavior when its variable is unset, so
# the app runs correctly with none of these configured.
# ---------------------------------------------------------------------------

# Analytics (SRS Section 16) — Google Tag Manager container ID.
# GA4, Microsoft Clarity, Meta Pixel, and LinkedIn Insight Tag are all
# configured *inside* the GTM container itself, not as separate env vars —
# see SRS 16: "Google Tag Manager: Central tag governance, no hardcoded
# marketing pixels in codebase." Unset: GoogleTagManager renders nothing.
NEXT_PUBLIC_GTM_ID=

# Customer support chat (Tawk.to) — no env var: TawkChat.tsx loads the
# official embed script with its property/widget IDs baked into the src
# URL by Tawk.to itself. Widget behavior is configured from the Tawk.to
# dashboard, not from environment variables.

# --- Not yet consumed by code; reserved for the integrations documented ---
# --- as BLOCKERs throughout src/lib/services/. Add here once each is    ---
# --- provisioned, per SRS 30.5 ("stored in a dedicated secrets manager  ---
# --- and injected at build/runtime — never committed to source control  ---
# --- or exposed in client-side bundles").                                ---

# ZynReach Admin/CMS Dashboard (System B) — Content Management read path
# (src/lib/services/cms-content.ts). Unlike the entries below, System B is
# already running, not a future credential: set these to enable
# /{locale}/cms/{slug} pages authored and Published through System B.
# Unset: those routes 404 (this app still runs standalone otherwise).
ZYNREACH_ADMIN_API_URL=
ZYNREACH_ADMIN_SERVICE_TOKEN=

# CRM integration (lead-router.ts) — e.g. Salesforce/HubSpot API credentials.
# CRM_API_KEY=

# Scheduling integration (Book a Demo calendar embed).
# SCHEDULING_API_KEY=

# ATS integration (careers.ts job listing sync, FR-WEB-020).
# ATS_API_KEY=

# Resume storage (career-application.ts) — object storage credentials.
# RESUME_STORAGE_BUCKET=
# RESUME_STORAGE_ACCESS_KEY=
# RESUME_STORAGE_SECRET_KEY=

# Status provider (status-provider.ts) — e.g. Statuspage.io, Better Stack.
# STATUS_PROVIDER_API_KEY=

# CAPTCHA provider (layered spam defense alongside the honeypot fields
# already implemented in every public form).
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# Error monitoring (monitoring.ts) — e.g. Sentry DSN.
# SENTRY_DSN=

# Transactional email provider (demo confirmations, trial verification,
# gated content delivery).
# EMAIL_PROVIDER_API_KEY=
