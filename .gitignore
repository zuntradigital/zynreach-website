# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/lighthouse-report/
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# env files — never commit real secrets; the template stays tracked
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caches
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# secrets / credentials / keys
*.key
*.crt
*.p12
*.pfx
*credentials*.json
secrets/
*.local

# local databases / runtime files
*.sqlite
*.sqlite3
*.db

# Claude Code local-only settings (machine/user-specific, not shared)
.claude/settings.local.json

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
